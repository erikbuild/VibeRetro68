/* Auto-generated by CMake from the project VERSION file -- do not edit.
   Bump /VERSION and rebuild; both the 'vers' resource (which the
   Finder reads for Get Info) and the APP_VERSION_STR compile-time
   #define follow automatically. */

resource 'vers' (1, purgeable) {
    0x0@APP_VER_MAJOR@,
    0x@APP_VER_MINOR@@APP_VER_PATCH@,
    0x80,                /* stage: final (0x20 dev / 0x40 alpha / 0x60 beta / 0x80 final) */
    0x00,                /* non-release counter */
    verUS,
    "@APP_VERSION@",
    "@APP_VERSION@"
};
